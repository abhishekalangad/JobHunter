# ============================================================
# AI Job Hunter - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Application
APP_NAME="AI Job Hunter"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=sqlite+aiosqlite:///./job_hunter.db

# ChromaDB Vector Store
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_RESUMES=resumes
CHROMA_COLLECTION_JOBS=jobs

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# File Storage
RESUME_UPLOAD_DIR=./resumes
MAX_FILE_SIZE_MB=10

# Email (Gmail SMTP)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password-here
EMAIL_FROM_NAME=Job Application Bot

# OCR
OCR_LANGUAGE=en

# RAG Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.6
