# Set the default behavior to automatically normalize line endings
* text=auto

# Declare files that should always have LF line endings in the repository
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Declare files that must always use CRLF line endings (Windows batch files)
*.bat text eol=crlf
*.cmd text eol=crlf
